# Generated by Cargo
# will have compiled files and executables
/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# Mac stuff
.DS_Store

# Intellij stuff
.idea/
*.iml

# Perf stuff
perf.data
perf.data.old

# Result files (heaptrail's --json output sidecars; do NOT ignore plugin
# manifests under .claude-plugin/ or plugins/)
/heaptrail.json
/heaptrail-*.json

# Heap dump fixtures (large; never commit captured dumps)
*.hprof

# User guide (MkDocs): build output and the local virtualenv
/build/
/.venv/

# Local working plans stay local (docs/ used to be ignored wholesale)
/docs/superpowers/plans/

# Python bytecode from the docs scripts
__pycache__/
